# Sao chép file này thành .env rồi điền giá trị thật.
# LƯU Ý: không commit file .env lên git.

# --- Bắt buộc để chạy bot Telegram ---
# Lấy từ @BotFather trên Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Chỉ những ID này được dùng bot (phân tách bằng dấu phẩy).
# Để trống = ai cũng dùng được (KHÔNG khuyến khích vì bạn trả tiền token).
# Cách lấy ID: nhắn gì cho bot, bot sẽ in ID của bạn khi bị từ chối.
TELEGRAM_ALLOWED_IDS=

# --- Bắt buộc cho phần suy luận AI (lệnh /a và /ask) ---
# Lấy từ https://platform.claude.com  → API keys
# Không có key thì lệnh /q (phân tích nhanh) vẫn chạy bình thường.
ANTHROPIC_API_KEY=

# --- Tuỳ chọn ---
# Khung thời gian mặc định khi không ghi rõ trong lệnh
DEFAULT_INTERVAL=4h

# Sao chép file này thành .env rồi điền giá trị thật.
# LƯU Ý: không commit file .env lên git (.gitignore đã chặn sẵn).

# --- Bắt buộc: PostgreSQL là nguồn dữ liệu duy nhất ---
DATABASE_POOL_SIZE=10
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/trading
DATABASE_USER=trading
DATABASE_PASSWORD=replace-with-a-long-random-password

# Docker Compose / PostgreSQL local
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8080

# --- Bắt buộc để chạy bot Telegram ---
# Lấy từ @BotFather trên Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# --- GitHub Actions scan (Java command alerts-once) ---
# Chat id nhận cảnh báo, cách nhau bằng dấu phẩy. Trên GitHub, đặt giá trị này
# trong repository secret TELEGRAM_ALERT_CHAT_IDS của chính repo này, không commit.
TELEGRAM_ALERT_CHAT_IDS=

# Chỉ những ID này được dùng bot. Để trống = không giới hạn.
TELEGRAM_ALLOWED_IDS=

# Dành cho tích hợp Anthropic phía server khi được bật.
ANTHROPIC_API_KEY=

# --- Tuỳ chọn ---
# Khung thời gian mặc định khi không ghi rõ trong lệnh
DEFAULT_INTERVAL=4h

# Port container/Render. Local mặc định dùng JAVA_SERVER_PORT=8080.
PORT=8080
JAVA_SERVER_PORT=8080

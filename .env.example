# Sao chép file này thành .env rồi điền giá trị thật.
# LƯU Ý: không commit file .env lên git (.gitignore đã chặn sẵn).

# --- Bắt buộc: TiDB Cloud ngoài Docker (giao thức MySQL) ---
# Lấy endpoint, database và username từ trang Connect của TiDB Cloud.
# Bắt buộc giữ sslMode=VERIFY_IDENTITY để xác thực TLS.
# Nếu cluster cấp CA riêng, import CA vào Java truststore hoặc thêm
# trustCertificateKeyStoreUrl/trustCertificateKeyStorePassword theo tài liệu TiDB.
DATABASE_POOL_SIZE=5
# TiDB Cloud can rotate/close public connections; recycle pool connections after 5 minutes.
DATABASE_MAX_LIFETIME_MS=300000
JDBC_DATABASE_URL=jdbc:mysql://<tidb-cloud-endpoint>:4000/<database>?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&connectionTimeZone=UTC
DATABASE_USER=<tidb-cloud-username>
DATABASE_PASSWORD=<tidb-cloud-password>
WEB_PORT=8080
# Bắt buộc true khi deploy HTTPS; chỉ đổi false khi chạy localhost HTTP.
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=8h

# --- Đăng nhập bằng tên đăng nhập/mật khẩu (tuỳ chọn) ---
# Phải điền đủ bốn biến. Chỉ lưu BCrypt hash cost 12, không lưu mật khẩu thô.
# Khi dùng Docker Compose, đặt hash giữa nháy đơn, ví dụ: '$2b$12$...'
# để Compose không nội suy ký tự $.
# Google/GitHub (nếu cấu hình) luôn là tài khoản normal/viewer, không có quyền ghi/xóa.
LOCAL_AUTH_ADMIN_USERNAME=
LOCAL_AUTH_ADMIN_PASSWORD_HASH=
LOCAL_AUTH_VIEWER_USERNAME=
LOCAL_AUTH_VIEWER_PASSWORD_HASH=

# --- Bắt buộc để chạy bot Telegram ---
# Lấy từ @BotFather trên Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# --- Nhap lich su Telegram bang tai khoan nguoi dung (chi CLI tools) ---
# Tao o https://my.telegram.org/apps. Khong phai bot token va khong commit hai gia tri nay.
# Lenh dau tien se hoi so dien thoai, OTP va 2FA ngay tren terminal Docker.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- GitHub Actions scan (Java command alerts-once) ---
# Chat id nhận cảnh báo, cách nhau bằng dấu phẩy. Trên GitHub, đặt giá trị này
# trong repository secret TELEGRAM_ALERT_CHAT_IDS của chính repo này, không commit.
TELEGRAM_ALERT_CHAT_IDS=

# Chỉ những ID này được dùng bot. Để trống = không giới hạn.
TELEGRAM_ALLOWED_IDS=

# Chu bot: bat buoc cho cac lenh thay doi state (/set, /add, /del, /canhbao).
# De trong se fail-closed va chan toan bo lenh ghi.
TELEGRAM_OWNER_IDS=

# Dành cho tích hợp Anthropic phía server khi được bật.
ANTHROPIC_API_KEY=

# --- Tuỳ chọn ---
# Khung thời gian mặc định khi không ghi rõ trong lệnh
DEFAULT_INTERVAL=4h

# --- Hoc tu keo da dong (chi chay trong service bot) ---
# Hang ngay 08:07; don lich su Thu Hai 08:37, gio Viet Nam.
# Chi xoa keo DA DONG qua 30 ngay; giu keo mo, model, cau hinh va learning log.
TRADING_TIMEZONE=Asia/Ho_Chi_Minh
TRADING_LEARNING_SCHEDULER_ENABLED=true
TRADING_DAILY_LEARNING_CRON=0 7 8 * * *
TRADING_WEEKLY_HISTORY_PURGE_CRON=0 37 8 * * MON
TRADING_HISTORY_RETENTION_DAYS=30
TRADING_DAILY_MODEL_MAX_PAIRS=3
TRADING_DAILY_MODEL_TRAINING_ENABLED=true

# Port container/Render. Local mặc định dùng JAVA_SERVER_PORT=8080.
PORT=8080
JAVA_SERVER_PORT=8080

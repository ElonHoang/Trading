# Sao chép file này thành .env rồi điền giá trị thật.
# LƯU Ý: không commit file .env lên git (.gitignore đã chặn sẵn).

# --- Bắt buộc để chạy bot Telegram ---
# Lấy từ @BotFather trên Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# --- Bot chart (npm run bot) ---
# Chỉ những user id này được dùng lệnh GHI: /canhbao, /tatcanhbao, /add, /del.
# Lệnh chỉ đọc (/ta, /gia, /list, /id) thì ai cũng dùng được.
# ĐỂ TRỐNG = CHẶN HẾT lệnh ghi (fail-closed) — an toàn khi bot ở trong group.
# Cách lấy id: gửi /id cho bot.
TELEGRAM_OWNER_IDS=

# --- Bot AI (npm run bot:ai) ---
# Chỉ những ID này được dùng bot. Để trống = ai cũng dùng được
# (KHÔNG khuyến khích vì bạn trả tiền token Claude).
TELEGRAM_ALLOWED_IDS=

# --- Bắt buộc cho phần suy luận AI (lệnh /a và /ask của bot trên main) ---
# Lấy từ https://platform.claude.com  → API keys
# Không có key thì lệnh /q (phân tích nhanh) vẫn chạy bình thường.
ANTHROPIC_API_KEY=

# --- Tuỳ chọn ---
# Khung thời gian mặc định khi không ghi rõ trong lệnh
DEFAULT_INTERVAL=4h

# Port cho web UI realtime (npm start). Mặc định 3000.
PORT=3001

{
  "name": "ta-ai-bot",
  "version": "1.0.0",
  "description": "AI technical-analysis bot for crypto tokens: indicators + gradient boosting model + Claude reasoning, delivered over Telegram",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "start": "node --env-file-if-exists=.env src/server.js",
    "bot": "node --env-file-if-exists=.env src/telegram/bot.js",
    "alerts:once": "node --env-file-if-exists=.env src/telegram/alerts-once.js",
    "scan:github": "node --env-file-if-exists=.env src/telegram/alerts-once.js",
    "bot:ai": "node --env-file-if-exists=.env src/bot.js",
    "analyze": "node --env-file-if-exists=.env src/cli.js",
    "train": "node --env-file-if-exists=.env bin/train.js",
    "backtest": "node --env-file-if-exists=.env bin/backtest.js",
    "review:daily": "node --env-file-if-exists=.env bin/daily-review.js",
    "learn:losses": "node --env-file-if-exists=.env bin/daily-review.js --force --yesterday --log-learning",
    "train:losses": "node --env-file-if-exists=.env bin/daily-review.js --force --yesterday --log-learning",
    "diagnose:sl": "node --env-file-if-exists=.env bin/diagnose-stoploss.js",
    "validate:filters": "node --env-file-if-exists=.env bin/validate-entry-filters.js",
    "research:patterns": "node --env-file-if-exists=.env bin/research-patterns.js",
    "models:index": "node bin/build-model-index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@napi-rs/canvas": "^1.0.3",
    "express": "^5.2.1",
    "grammy": "^1.45.1"
  }
}

# Sao chép file này thành server-java/.env rồi điền OAuth credentials.
JAVA_SERVER_PORT=8080

# PostgreSQL là nguồn dữ liệu duy nhất. Java dùng JDBC URL; Node dùng DATABASE_URL.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/trading
DATABASE_USER=trading
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10

# false khi chạy localhost HTTP; true khi deploy bằng HTTPS.
SESSION_COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

TRADING_TIMEZONE=Asia/Bangkok

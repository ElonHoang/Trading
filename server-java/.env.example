# Sao chép file này thành server-java/.env rồi điền OAuth credentials.
JAVA_SERVER_PORT=8080

# TiDB Cloud là database MySQL-compatible bên ngoài; không chạy PostgreSQL local.
# Dùng endpoint, database và username ở trang Connect của TiDB Cloud. Bắt buộc xác thực TLS;
# thêm Java truststore URL/password nếu CA do cluster yêu cầu không nằm trong truststore mặc định.
JDBC_DATABASE_URL=jdbc:mysql://<tidb-cloud-endpoint>:4000/<database>?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&connectionTimeZone=UTC
DATABASE_USER=<tidb-cloud-username>
DATABASE_PASSWORD=<tidb-cloud-password>
DATABASE_POOL_SIZE=5
DATABASE_MAX_LIFETIME_MS=300000

# false khi chạy localhost HTTP; bắt buộc đặt true khi deploy bằng HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=8h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Đăng nhập nội bộ (tuỳ chọn). Phải điền đủ bốn biến để bật.
# Chỉ lưu BCrypt hash cost 12, không lưu mật khẩu thật.
# Khi dùng Docker Compose, đặt hash giữa nháy đơn, ví dụ: '$2b$12$...'
# để Compose không nội suy ký tự $.
# Google/GitHub (nếu cấu hình) luôn là tài khoản normal/viewer, không có quyền ghi/xóa.
LOCAL_AUTH_ADMIN_USERNAME=
LOCAL_AUTH_ADMIN_PASSWORD_HASH=
LOCAL_AUTH_VIEWER_USERNAME=
LOCAL_AUTH_VIEWER_PASSWORD_HASH=

TRADING_TIMEZONE=Asia/Ho_Chi_Minh
TRADING_LEARNING_SCHEDULER_ENABLED=false
TRADING_DAILY_LEARNING_CRON=0 7 8 * * *
TRADING_WEEKLY_HISTORY_PURGE_CRON=0 37 8 * * MON
TRADING_HISTORY_RETENTION_DAYS=30
TRADING_DAILY_MODEL_MAX_PAIRS=3
TRADING_DAILY_MODEL_TRAINING_ENABLED=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_ALERT_CHAT_IDS=

# Telegram User API cho CLI import lich su, khong phai bot token.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

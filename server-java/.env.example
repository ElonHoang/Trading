# Sao chép file này thành server-java/.env rồi điền OAuth credentials.
JAVA_SERVER_PORT=8080

# TiDB Cloud là database MySQL-compatible bên ngoài; không chạy PostgreSQL local.
# Dùng endpoint, database và username ở trang Connect của TiDB Cloud. Bắt buộc xác thực TLS;
# thêm Java truststore URL/password nếu CA do cluster yêu cầu không nằm trong truststore mặc định.
JDBC_DATABASE_URL=jdbc:mysql://<tidb-cloud-endpoint>:4000/<database>?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&connectionTimeZone=UTC
DATABASE_USER=<tidb-cloud-username>
DATABASE_PASSWORD=<tidb-cloud-password>
DATABASE_POOL_SIZE=5
DATABASE_MAX_LIFETIME_MS=300000

# false khi chạy localhost HTTP; true khi deploy bằng HTTPS.
SESSION_COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

TRADING_TIMEZONE=Asia/Bangkok

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_ALERT_CHAT_IDS=

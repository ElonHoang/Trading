# Sao chép file này thành server-java/.env rồi điền OAuth credentials.
JAVA_SERVER_PORT=8080

# false khi chạy localhost HTTP; true khi deploy bằng HTTPS.
SESSION_COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Tuỳ chọn cho biểu đồ hiệu suất. Để trống thì server tự tìm trong thư mục data/ và config/.
# TRADING_STATE_FILE=D:/Tool/data/auto-retune.json
# TRADING_STRATEGY_FILE=D:/Tool/config/strategy.json
TRADING_TIMEZONE=Asia/Bangkok
